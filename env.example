# Panik server settings. Copy this file to .env and change what you need:
#     cp .env.example .env
# .env is ignored by git. Anything missing here uses the default shown.

# Address and port the server listens on. 0.0.0.0 = reachable from other devices on the Wi-Fi.
# If you change the port, also change the server addresses in esp8266_panik/secrets.h.
PANIK_HOST=0.0.0.0
PANIK_PORT=5000

# SQLite database file (relative paths are next to server.py)
PANIK_DB=panik.db

# Timings in seconds
PANIK_LOST_CONTACT_S=15       # open incident with no location update for this long -> LOST CONTACT
PANIK_ONLINE_TIMEOUT_S=75     # device not heard from for this long -> OFFLINE
PANIK_REUSE_WINDOW_S=300      # a restarted board continues its open incident only if updated this recently